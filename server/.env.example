PORT=5000
MONGO_URI=mongodb://localhost:27017/shopping_mall
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# 사업자등록증 OCR (네이버 클라우드 CLOVA OCR)
# 콘솔 > CLOVA OCR > Domain 생성 후 APIGW Invoke URL과 Secret Key를 입력한다.
# 사업자등록증 전용 템플릿으로 만들면 항목이 구조화되어 오고,
# General 도메인으로 만들면 인식된 텍스트를 정규식으로 파싱한다. 둘 다 동작한다.
# 미설정 시 텍스트가 들어있는 PDF만 자동 완성되고, 이미지 업로드는 안내 메시지를 반환한다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# 청구서를 보내는 계정 (Microsoft Graph Mail.Send 권한 필요)
INVOICE_SENDER_EMAIL=rent@example.com
